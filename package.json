{
  "name": "go-lab",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "scripts": {
    "start": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:client": "ng serve --host 127.0.0.1 --port 4201",
    "dev:server": "go run ./server",
    "runner:build": "docker build --tag go-lab-runner:1.27.4 runner",
    "build": "pnpm run build:client && pnpm run build:server",
    "build:client": "ng build",
    "build:server": "go build -o bin/ ./server",
    "serve": "go run ./server",
    "test": "go test ./... && node --test deployment/check-runner-health.test.mjs && node scripts/check-course.mjs",
    "test:course": "node scripts/check-course.mjs",
    "test:ui": "playwright test",
    "format": "prettier --write . && gofmt -w server",
    "format:check": "prettier --check . && node scripts/check-gofmt.mjs"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/theme-one-dark": "6.1.3",
    "codemirror": "6.0.2",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@playwright/test": "1.65.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "vite": "8.3.5"
  }
}
